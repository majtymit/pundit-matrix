<% table_class = local_assigns[:table_class] %>
<%= render 'pundit/matrix/style' %>
<table class="<%= class_names('pundit-matrix', table_class) %>">
  <% Pundit::Matrix.layout(self).groups.each do |group| %>
    <tbody>
      <% if group.label %>
        <tr><th scope="rowgroup" colspan="2"><%= group.label %></th></tr>
      <% end %>
      <% group.rows.each do |row| %>
        <% level = role.level(row.screen) %>
        <tr>
          <th scope="row"><%= row.label %></th>
          <td class="pundit-matrix-<%= level %>">
            <% if level == :none %>
              <span title="<%= Pundit::Matrix.t('levels.none') %>">–</span>
            <% else %>
              <%= Pundit::Matrix.t("levels.#{level}") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
</table>
