<% scope = local_assigns.fetch(:scope, role.model_name.param_key) %>
<% table_class = local_assigns[:table_class] %>
<% if role.admin? %>
  <p class="pundit-matrix-admin"><%= Pundit::Matrix.t('admin_role') %></p>
<% else %>
  <%= render 'pundit/matrix/style' %>
  <table class="<%= class_names('pundit-matrix', table_class) %>">
    <thead>
      <tr>
        <th></th>
        <% Pundit::Matrix::LEVELS.each do |level| %>
          <th scope="col" class="pundit-matrix-level"><%= Pundit::Matrix.t("levels.#{level}") %></th>
        <% end %>
      </tr>
    </thead>
    <% Pundit::Matrix.screens.group_by(&:group).each do |group, screens| %>
      <tbody>
        <% if group %>
          <tr><th scope="rowgroup" colspan="<%= Pundit::Matrix::LEVELS.size + 1 %>"><%= screens.first.group_label %></th></tr>
        <% end %>
        <% screens.each do |screen| %>
          <% current = role.levels.fetch(screen.key, :none) %>
          <tr>
            <td><%= screen.label %></td>
            <% Pundit::Matrix::LEVELS.each do |level| %>
              <td class="pundit-matrix-level">
                <% if screen.levels.include?(level) %>
                  <%= radio_button_tag "#{scope}[levels][#{screen.key}]", level, current == level,
                                       'aria-label': "#{screen.label}: #{Pundit::Matrix.t("levels.#{level}")}" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
<% end %>
