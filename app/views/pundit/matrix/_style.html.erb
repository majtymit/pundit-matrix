<%# Inline, so the matrix reads the same in any admin without touching its asset pipeline. %>
<style <%= tag.attributes(nonce: content_security_policy_nonce) %>>
  .pundit-matrix { border-collapse: collapse; }
  .pundit-matrix th, .pundit-matrix td { padding: 0.5em 0.75em; }
  <%# Only the form: on the detail the admin's attributes table draws its own rows. %>
  .pundit-matrix-levels .pundit-matrix td { border-bottom: 1px solid rgba(127, 127, 127, 0.25); }
  .pundit-matrix thead th { background: none; }
  .pundit-matrix th[scope="rowgroup"] {
    padding-top: 1.75em; text-align: left; font-weight: bold; font-size: 1.15em; text-transform: none;
  }
  .pundit-matrix .pundit-matrix-level { width: 20%; text-align: center; }
  <%# The width of ActiveAdmin's text inputs, so the matrix lines up with the fields above it. %>
  .pundit-matrix-levels .pundit-matrix { width: calc(80% - 22px); }
  .pundit-matrix .pundit-matrix-write { color: #15803d; }
  .pundit-matrix .pundit-matrix-read { color: #b45309; }
</style>
