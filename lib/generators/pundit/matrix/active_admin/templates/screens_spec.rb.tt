require 'rails_helper'
require 'pundit/matrix/rspec'

# Holds every resource and page of the <%= namespace %> namespace to the matrix: an address needs its level, the menu
# shows only what is open, read offers no change and write offers what an admin gets.
RSpec.describe 'Pundit::Matrix screens of <%= namespace %>', type: :request do
<% if devise? -%>
  include Devise::Test::IntegrationHelpers

<% end -%>
  before { ActiveAdmin.application.load! }

  it 'gives every resource and page a screen, an admin screen or an open screen' do
    expect(screens.reject { |screen| screen[:access] }.map { |screen| screen[:name] }).to be_empty
  end

  it 'refuses a screen without its level' do
    screens_with(:screen).each do |screen|
      sign_in grant_levels(create_subject, **other_screen_read(screen[:key]))

      get screen[:path]

      expect(response).to have_http_status(:redirect), screen[:name]
    end
  end

  it 'opens a screen with read, shows only its screen in the menu and offers no change' do
    screens_with(:screen).each do |screen|
      someone = grant_levels(create_subject, screen[:key] => :read)
      sign_in someone

      get screen[:path]

      expect(response).to have_http_status(:ok), screen[:name]
      expect(menu_paths - open_paths).to match_array(menu_paths_of(screen[:key])), screen[:name]
      expect(answers(screen, someone).values).to all(be(false)), screen[:name]
    end
  end

  it 'offers with write what an admin gets' do
    admin = make_admin(create_subject)

    screens_with(:screen).reject { |screen| Pundit::Matrix.screens.fetch(screen[:key]).read_only? }.each do |screen|
      someone = grant_levels(create_subject, screen[:key] => :write)

      expect(answers(screen, someone)).to eq(answers(screen, admin)), screen[:name]
    end
  end

  it 'leaves the actions of another screen to whoever writes there' do
    screens_with(:screen).each do |screen|
      actions_of_other_screens(screen).each do |action, key|
        someone = grant_levels(create_subject, key => :write)

        expect(authorized?(screen, someone, action)).to be(true), "#{screen[:name]} #{action}"
      end
    end
  end

  it 'opens an admin screen to admins only' do
    admin = make_admin(create_subject)
    highest_levels = Pundit::Matrix.screens.to_h { |screen| [screen.key, screen.levels.last] }
    everything = grant_levels(create_subject, **highest_levels)

    screens_with(:admin).each do |screen|
      sign_in admin
      get screen[:path]
      expect(response).to have_http_status(:ok), screen[:name]

      sign_in everything
      get screen[:path]
      expect(response).to have_http_status(:redirect), screen[:name]
    end
  end

  it 'opens an open screen to everyone signed in' do
    screens_with(:open).each do |screen|
      sign_in create_subject

      get screen[:path]

      expect(response).to have_http_status(:ok), screen[:name]
    end
  end

  # Resources and pages that knowingly stay outside the matrix, by name.
  def outside_the_matrix
    %w[Comment]
  end

  def create_subject
<% if factory_bot? -%>
    create(:<%= subject_name.underscore %>)
<% elsif devise? -%>
    <%= subject_name %>.create!(email: "subject-#{SecureRandom.hex(6)}@example.test", password: SecureRandom.base58(24))
<% else -%>
    <%= subject_name %>.create!(email: "subject-#{SecureRandom.hex(6)}@example.test")
<% end -%>
  end
<% unless devise? -%>

  def sign_in(_subject)
    raise NotImplementedError, 'Sign the subject in the way your app does'
  end
<% end -%>

  def screens
    @screens ||= ActiveAdmin.application.namespaces[:<%= namespace %>].resources.filter_map do |resource|
      next if resource.resource_name.to_s.in?(outside_the_matrix)

      kind, key = access_of(resource)
      {
        name: resource.resource_name.to_s,
        access: kind,
        key:,
        path: resource.route_collection_path,
        in_menu: resource.include_in_menu?,
        resource:,
      }
    end
  end

  def screens_with(kind)
    screens.select { |screen| screen[:access] == kind }
  end

  def access_of(resource)
    return resource.matrix_access if resource.is_a?(ActiveAdmin::Page)

    policy = adapter(resource, nil).retrieve_policy(resource.resource_class).class
    return [:screen, policy.matrix_screen] if policy.respond_to?(:matrix_screen)

    [:admin] if policy.try(:matrix_admin_screen?)
  end

  def adapter(resource, subject)
    ActiveAdmin::PunditAdapter.new(resource, subject)
  end

  def authorized?(screen, subject, action)
    adapter(screen[:resource], subject).authorized?(action.to_sym, screen[:resource].resource_class)
  end

  # Asked about the model, the way a screen asks whether a button exists at all.
  def answers(screen, subject)
    resource = screen[:resource]
    return {} if resource.is_a?(ActiveAdmin::Page)

    actions = (resource.controller.action_methods & %w[new create edit update destroy]).to_a
    actions += (resource.member_actions + resource.collection_actions).map { |action| action.name.to_s }
    actions -= actions_of_other_screens(screen).keys.map(&:to_s)

    actions.index_with { |action| authorized?(screen, subject, action) }
  end

  def actions_of_other_screens(screen)
    resource = screen[:resource]
    return {} if resource.is_a?(ActiveAdmin::Page)

    adapter(resource, nil).retrieve_policy(resource.resource_class).class.try(:matrix_screen_actions) || {}
  end

  def other_screen_read(key)
    other = Pundit::Matrix.screens.find { |screen| screen.key != key }
    other ? { other.key => :read } : {}
  end

  def menu_paths_of(key)
    screens.select { |screen| screen[:key] == key && screen[:in_menu] }.map { |screen| screen[:path] }
  end

  def open_paths
    ['/<%= namespace %>', *screens_with(:open).map { |screen| screen[:path] }]
  end

  def menu_paths
    Nokogiri::HTML(response.body).css('#tabs a[href^="/<%= namespace %>"]').map { |link| link['href'] }.uniq
  end
end
