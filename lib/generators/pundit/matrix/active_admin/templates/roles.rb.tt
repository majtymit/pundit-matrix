ActiveAdmin.register Pundit::Matrix::Role, as: 'Role', namespace: :<%= namespace %> do
  config.sort_order = 'position_asc'

  permit_params do
    role_policy.permitted_attributes
  end

  controller do
    helper_method :role_policy, :role_order_shown?

    def role_policy
      Pundit.policy!(current_active_admin_user, [:<%= namespace %>, Pundit::Matrix::Role])
    end

    # Moving a role in a filtered or reordered list would pass neighbours the list does not show.
    def role_order_shown?
      params[:q].blank? && params.fetch(:order, 'position_asc') == 'position_asc'
    end
  end

  member_action :move_up, method: :put do
    resource.move_up
    redirect_to collection_path
  end

  member_action :move_down, method: :put do
    resource.move_down
    redirect_to collection_path
  end

  filter :name

  sidebar :superadmin, only: :index, if: -> { !<%= subject_name %>.active_superadmins.exists? } do
    render 'pundit/matrix/superadmin_warning', subjects: <%= subject_name %>
  end

  index do
    column :name
    column :position do |role|
      span role.position
      if role_order_shown?
        if role.movable_up? && authorized?(:move_up, role)
          a '↑', href: move_up_<%= namespace %>_role_path(role), 'data-method': :put, title: Pundit::Matrix.t('move_up')
        end
        if role.movable_down? && authorized?(:move_down, role)
          a '↓', href: move_down_<%= namespace %>_role_path(role), 'data-method': :put, title: Pundit::Matrix.t('move_down')
        end
      end
    end
    actions
  end

  show do
    attributes_table do
      row :name
      row :position
    end

    panel Pundit::Matrix::Role.human_attribute_name(:permissions) do
      render 'pundit/matrix/levels', role: resource, table_class: 'index_table'
    end
  end

  form do |f|
    f.semantic_errors(*f.object.errors.attribute_names)

    f.inputs do
      f.input :name
      f.input :position, input_html: { disabled: true }
    end

    f.inputs Pundit::Matrix::Role.human_attribute_name(:permissions) do
      li { render 'pundit/matrix/levels_fields', role: f.object, table_class: 'index_table' }
    end

    f.actions
  end
end
